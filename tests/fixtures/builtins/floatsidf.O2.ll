  %conv6 = zext nneg i32 %add to i64
  %shl7 = shl nuw nsw i64 %conv6, 52
  %add8 = add i64 %xor, %shl7
  %or = or i64 %add8, %sign.0
  %1 = bitcast i64 %or to double
  br label %cleanup

cleanup:                                          ; preds = %entry, %if.end
  %retval.0 = phi double [ %1, %if.end ], [ 0.000000e+00, %entry ]
  ret double %retval.0
}

