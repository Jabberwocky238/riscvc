  %sub5 = sub nuw nsw i32 52, %sub4
  %conv = zext i32 %aAbs.0 to i64
  %sh_prom = zext nneg i32 %sub5 to i64
  %shl = shl i64 %conv, %sh_prom
  %xor = xor i64 %shl, 4503599627370496
