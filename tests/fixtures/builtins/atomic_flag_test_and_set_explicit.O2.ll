define dso_local zeroext i1 @atomic_flag_test_and_set_explicit(ptr noundef %object, i32 noundef %order) local_unnamed_addr #0 {
entry:
  switch i32 %order, label %monotonic [
    i32 1, label %acquire
    i32 2, label %acquire
    i32 3, label %release
    i32 4, label %acqrel
    i32 5, label %seqcst
  ]

monotonic:                                        ; preds = %entry
  %0 = atomicrmw volatile xchg ptr %object, i8 1 monotonic, align 1
  %extract.t17 = trunc i8 %0 to i1
  br label %atomic.continue

acquire:                                          ; preds = %entry, %entry
  %1 = atomicrmw volatile xchg ptr %object, i8 1 acquire, align 1
  %extract.t16 = trunc i8 %1 to i1
  br label %atomic.continue

release:                                          ; preds = %entry
  %2 = atomicrmw volatile xchg ptr %object, i8 1 release, align 1
  %extract.t15 = trunc i8 %2 to i1
  br label %atomic.continue

acqrel:                                           ; preds = %entry
  %3 = atomicrmw volatile xchg ptr %object, i8 1 acq_rel, align 1
  %extract.t14 = trunc i8 %3 to i1
  br label %atomic.continue

seqcst:                                           ; preds = %entry
  %4 = atomicrmw volatile xchg ptr %object, i8 1 seq_cst, align 1
  %extract.t13 = trunc i8 %4 to i1
  br label %atomic.continue

atomic.continue:                                  ; preds = %seqcst, %acqrel, %release, %acquire, %monotonic
  %.sink.off0 = phi i1 [ %extract.t13, %seqcst ], [ %extract.t14, %acqrel ], [ %extract.t15, %release ], [ %extract.t16, %acquire ], [ %extract.t17, %monotonic ]
  ret i1 %.sink.off0
}

