; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define dso_local i64 @__fixunsdfdi(double noundef %a) local_unnamed_addr #0 {
entry:
  %cmp = fcmp ugt double %a, 0.000000e+00
  br i1 %cmp, label %if.end, label %return

if.end:                                           ; preds = %entry
  %div = fmul double %a, 0x3DF0000000000000
  %conv = fptoui double %div to i32
  %conv1 = uitofp i32 %conv to double
  %neg = fneg double %conv1
  %0 = tail call double @llvm.fmuladd.f64(double %neg, double 0x41F0000000000000, double %a)
  %conv2 = fptoui double %0 to i32
  %conv3 = zext i32 %conv to i64
  %shl = shl nuw i64 %conv3, 32
  %conv4 = zext i32 %conv2 to i64
  %or = or disjoint i64 %shl, %conv4
  br label %return

return:                                           ; preds = %entry, %if.end
  %retval.0 = phi i64 [ %or, %if.end ], [ 0, %entry ]
  ret i64 %retval.0
}

