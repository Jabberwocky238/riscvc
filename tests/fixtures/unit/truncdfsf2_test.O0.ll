source_filename = "../llvm-project/compiler-rt/test/builtins/Unit/truncdfsf2_test.c"
target datalayout = "e-m:e-p:32:32-i64:64-n32-S128"
target triple = "riscv32-unknown-unknown-elf"

@.str = private unnamed_addr constant [50 x i8] c"error in test__truncdfsf2(%lf) = %f, expected %f\0A\00", align 1

; Function Attrs: noinline nounwind optnone
define dso_local i32 @test__truncdfsf2(double noundef %a) #0 {
entry:
  %retval = alloca i32, align 4
  %a.addr = alloca double, align 8
  %actual = alloca float, align 4
  %expected = alloca float, align 4
  store double %a, ptr %a.addr, align 8
  %0 = load double, ptr %a.addr, align 8
  %call = call float @__truncdfsf2(double noundef %0) #2
  store float %call, ptr %actual, align 4
  %1 = load double, ptr %a.addr, align 8
  %conv = fptrunc double %1 to float
  store float %conv, ptr %expected, align 4
  %2 = load float, ptr %actual, align 4
  %3 = load float, ptr %expected, align 4
  %cmp = fcmp une float %2, %3
  br i1 %cmp, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  %4 = load double, ptr %a.addr, align 8
  %5 = load float, ptr %actual, align 4
  %conv2 = fpext float %5 to double
  %6 = load float, ptr %expected, align 4
  %conv3 = fpext float %6 to double
  %call4 = call i32 (ptr, ...) @printf(ptr noundef @.str, double noundef %4, double noundef %conv2, double noundef %conv3) #2
  store i32 1, ptr %retval, align 4
  br label %return

if.end:                                           ; preds = %entry
  store i32 0, ptr %retval, align 4
  br label %return

return:                                           ; preds = %if.end, %if.then
  %7 = load i32, ptr %retval, align 4
  ret i32 %7
}

declare dso_local float @__truncdfsf2(double noundef) #1

declare dso_local i32 @printf(ptr noundef, ...) #1

; Function Attrs: noinline nounwind optnone
define dso_local i32 @main() #0 {
entry:
  %retval = alloca i32, align 4
  %call = call i32 @test__truncdfsf2(double noundef 0x47F0000000000000) #2
  %tobool = icmp ne i32 %call, 0
  br i1 %tobool, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  store i32 1, ptr %retval, align 4
  br label %return

if.end:                                           ; preds = %entry
  store i32 0, ptr %retval, align 4
  br label %return

return:                                           ; preds = %if.end, %if.then
  %0 = load i32, ptr %retval, align 4
  ret i32 %0
}

