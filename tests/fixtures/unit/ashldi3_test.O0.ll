@.str = private unnamed_addr constant [54 x i8] c"error in __ashldi3: %llX << %d = %llX, expected %llX\0A\00", align 1
@assumption_1 = dso_local global [1 x i8] zeroinitializer, align 1

; Function Attrs: noinline nounwind optnone
define dso_local i32 @test__ashldi3(i64 noundef %a, i32 noundef %b, i64 noundef %expected) #0 {
entry:
  %a.addr = alloca i64, align 8
  %b.addr = alloca i32, align 4
  %expected.addr = alloca i64, align 8
  %x = alloca i64, align 8
  store i64 %a, ptr %a.addr, align 8
  store i32 %b, ptr %b.addr, align 4
  store i64 %expected, ptr %expected.addr, align 8
  %0 = load i64, ptr %a.addr, align 8
  %1 = load i32, ptr %b.addr, align 4
  %call = call i64 @__ashldi3(i64 noundef %0, i32 noundef %1) #2
  store i64 %call, ptr %x, align 8
  %2 = load i64, ptr %x, align 8
  %3 = load i64, ptr %expected.addr, align 8
  %cmp = icmp ne i64 %2, %3
  br i1 %cmp, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  %4 = load i64, ptr %a.addr, align 8
  %5 = load i32, ptr %b.addr, align 4
  %6 = load i64, ptr %a.addr, align 8
  %7 = load i32, ptr %b.addr, align 4
  %call1 = call i64 @__ashldi3(i64 noundef %6, i32 noundef %7) #2
  %8 = load i64, ptr %expected.addr, align 8
  %call2 = call i32 (ptr, ...) @printf(ptr noundef @.str, i64 noundef %4, i32 noundef %5, i64 noundef %call1, i64 noundef %8) #2
  br label %if.end

if.end:                                           ; preds = %if.then, %entry
  %9 = load i64, ptr %x, align 8
  %10 = load i64, ptr %expected.addr, align 8
  %cmp3 = icmp ne i64 %9, %10
  %conv = zext i1 %cmp3 to i32
  ret i32 %conv
}

declare dso_local i64 @__ashldi3(i64 noundef, i32 noundef) #1

