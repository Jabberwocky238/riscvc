entry:
  %call = tail call float @__floatundisf(i64 noundef %a) #2
  %cmp = fcmp une float %call, %expected
  br i1 %cmp, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  %conv = fpext float %call to double
  %conv1 = fpext float %expected to double
  %call2 = tail call i32 (ptr, ...) @printf(ptr noundef nonnull @.str, i64 noundef %a, double noundef %conv, double noundef %conv1) #2
  br label %if.end

if.end:                                           ; preds = %if.then, %entry
  %conv4 = zext i1 %cmp to i32
  ret i32 %conv4
}

