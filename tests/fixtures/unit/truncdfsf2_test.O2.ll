source_filename = "../llvm-project/compiler-rt/test/builtins/Unit/truncdfsf2_test.c"
target datalayout = "e-m:e-p:32:32-i64:64-n32-S128"
target triple = "riscv32-unknown-unknown-elf"

@.str = private unnamed_addr constant [50 x i8] c"error in test__truncdfsf2(%lf) = %f, expected %f\0A\00", align 1

; Function Attrs: nounwind
define dso_local range(i32 0, 2) i32 @test__truncdfsf2(double noundef %a) local_unnamed_addr #0 {
entry:
  %call = tail call float @__truncdfsf2(double noundef %a) #2
  %conv = fptrunc double %a to float
  %cmp = fcmp une float %call, %conv
  br i1 %cmp, label %if.then, label %cleanup

if.then:                                          ; preds = %entry
  %conv2 = fpext float %call to double
  %conv3 = fpext float %conv to double
  %call4 = tail call i32 (ptr, ...) @printf(ptr noundef nonnull @.str, double noundef %a, double noundef %conv2, double noundef %conv3) #2
  br label %cleanup

cleanup:                                          ; preds = %entry, %if.then
  %retval.0 = phi i32 [ 1, %if.then ], [ 0, %entry ]
  ret i32 %retval.0
}

declare dso_local float @__truncdfsf2(double noundef) local_unnamed_addr #1

declare dso_local i32 @printf(ptr noundef, ...) local_unnamed_addr #1

; Function Attrs: nounwind
define dso_local range(i32 0, 2) i32 @main() local_unnamed_addr #0 {
entry:
  %call.i = tail call float @__truncdfsf2(double noundef 0x47F0000000000000) #2
  %cmp.i = fcmp une float %call.i, 0x7FF0000000000000
  br i1 %cmp.i, label %test__truncdfsf2.exit, label %0

test__truncdfsf2.exit:                            ; preds = %entry
  %conv2.i = fpext float %call.i to double
  %call4.i = tail call i32 (ptr, ...) @printf(ptr noundef nonnull @.str, double noundef 0x47F0000000000000, double noundef %conv2.i, double noundef 0x7FF0000000000000) #2
  br label %0

0:                                                ; preds = %entry, %test__truncdfsf2.exit
  %1 = phi i32 [ 1, %test__truncdfsf2.exit ], [ 0, %entry ]
  ret i32 %1
}

